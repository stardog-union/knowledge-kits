   rdfs:label "Shocker" ;
   <https://schema.org/description> "After being sent to the electric chair, a serial killer uses electricity to come back from the dead and carry out his vengeance on the football player who turned him in to the police." ;
   <https://schema.org/actor> <http://www.imdb.com/name/nm0000486> , <http://www.imdb.com/name/nm0614526> , <http://www.imdb.com/name/nm0005482> , <http://www.imdb.com/name/nm0683379> ;
