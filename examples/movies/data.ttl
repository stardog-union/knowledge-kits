   rdfs:label "Dum Laga Ke Haisha" ;
   <https://schema.org/description> "Prem and his oversized wife Sandhya are supposed to spend a lifetime together. Will a regular arranged marriage turn out to be a perfect mismatch?" ;
   <https://schema.org/actor> <http://www.imdb.com/name/nm4731677> , <http://www.imdb.com/name/nm0592799> , <http://www.imdb.com/name/nm0764384> , <http://www.imdb.com/name/nm6277267> ;
