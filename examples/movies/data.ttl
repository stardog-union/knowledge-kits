   rdfs:label "Nights in Rodanthe" ;
   <https://schema.org/description> "A doctor who is traveling to see his estranged son sparks with an unhappily married woman at a North Carolina inn." ;
   <https://schema.org/actor> <http://www.imdb.com/name/nm0000152> , <http://www.imdb.com/name/nm0205626> , <http://www.imdb.com/name/nm0000178> , <http://www.imdb.com/name/nm0005221> ;
