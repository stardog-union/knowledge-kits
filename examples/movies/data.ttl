   rdfs:label "The Ten Commandments" ;
   <https://schema.org/description> "The Egyptian Prince, Moses, learns of his true heritage as a Hebrew and his divine mission as the deliverer of his people." ;
   <https://schema.org/actor> <http://www.imdb.com/name/nm0000032> , <http://www.imdb.com/name/nm0000879> , <http://www.imdb.com/name/nm0000064> , <http://www.imdb.com/name/nm0000989> ;
