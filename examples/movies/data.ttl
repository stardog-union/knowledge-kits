   rdfs:label "Blood Ties" ;
   <https://schema.org/description> "Two brothers, on either side of the law, face off over organized crime in Brooklyn during the 1970s." ;
   <https://schema.org/actor> <http://www.imdb.com/name/nm0001082> , <http://www.imdb.com/name/nm0654110> , <http://www.imdb.com/name/nm0182839> , <http://www.imdb.com/name/nm0005109> ;
