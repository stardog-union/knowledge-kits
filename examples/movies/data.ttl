   <https://schema.org/keyword> "rocky" , "training" , "boxing" , "sweat" , "punching" ;
   <urn:stardog:demos:movies:rating> "5.2"^^xsd:float ;
   <urn:stardog:demos:movies:storyline> "Rocky Balboa is forced to retire after having permanent damage inflicted on him in the ring by the Russian boxer Ivan Drago. Returning home after the Drago bout, Balboa discovers that the fortune that he had acquired as heavyweight champ has been stolen and lost on the stockmarket by his accountant. His boxing days over, Rocky begins to coach an up-and-coming fighter named Tommy Gunn. Rocky cannot compete, however, with the high salaraies and glittering prizes being offered to Gunn by other managers in town." ;
   <https://schema.org/inLanguage> "English" , "Italian" .
<http://www.imdb.com/title/tt0112573> a <https://schema.org/Movie> ;
   rdfs:label "Braveheart" ;
   <https://schema.org/description> "When his secret bride is executed for assaulting an English soldier who tried to rape her, William Wallace begins a revolt against King Edward I of England." ;
   <https://schema.org/actor> <http://www.imdb.com/name/nm0001526> , <http://www.imdb.com/name/nm0000154> , <http://www.imdb.com/name/nm0000521> , <http://www.imdb.com/name/nm0005171> ;
