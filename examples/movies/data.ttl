   <https://schema.org/description> "A coming of age story set in the South of USA when Elvis was King." ;
   <https://schema.org/actor> <http://www.imdb.com/name/nm0001832> , <http://www.imdb.com/name/nm0000702> , <http://www.imdb.com/name/nm0002128> , <http://www.imdb.com/name/nm0834373> ;
