   rdfs:label "Missing" ;
   <https://schema.org/description> "When an idealistic writer disappears during the Right Wing military coup in 1973 Chile, his wife and American businessman father try to find him." ;
   <https://schema.org/actor> <http://www.imdb.com/name/nm0000493> , <http://www.imdb.com/name/nm0000651> , <http://www.imdb.com/name/nm0563039> , <http://www.imdb.com/name/nm0790291> ;
