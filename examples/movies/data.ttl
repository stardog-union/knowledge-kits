   <https://schema.org/description> "After losing his job, a middle-aged man reinvents himself by going back to college." ;
   <https://schema.org/actor> <http://www.imdb.com/name/nm0000158> , <http://www.imdb.com/name/nm0000210> , <http://www.imdb.com/name/nm0650945> , <http://www.imdb.com/name/nm2089529> ;
