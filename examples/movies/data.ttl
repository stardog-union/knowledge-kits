   rdfs:label "Earth Girls Are Easy" ;
   <https://schema.org/description> "A Southern California girl befriends three furry aliens after their spaceship lands in her swimming pool." ;
   <https://schema.org/actor> <http://www.imdb.com/name/nm0000133> , <http://www.imdb.com/name/nm0000156> , <http://www.imdb.com/name/nm0000120> , <http://www.imdb.com/name/nm0001834> ;
