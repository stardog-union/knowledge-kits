   rdfs:label "Race" ;
   <https://schema.org/description> "Jesse Owens' quest to become the greatest track and field athlete in history thrusts him onto the world stage of the 1936 Olympics, where he faces off against Adolf Hitler's vision of Aryan supremacy." ;
   <https://schema.org/actor> <http://www.imdb.com/name/nm0837177> , <http://www.imdb.com/name/nm2345856> , <http://www.imdb.com/name/nm4002412> , <http://www.imdb.com/name/nm4150847> ;
