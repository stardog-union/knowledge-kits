   rdfs:label "Something New" ;
   <https://schema.org/description> "Kenya McQueen, an accountant finds love in the most unexpected place when she agrees to go on a blind date with Brian Kelly, a sexy and free-spirited landscaper." ;
   <https://schema.org/actor> <http://www.imdb.com/name/nm0005125> , <http://www.imdb.com/name/nm0048932> , <http://www.imdb.com/name/nm0112001> , <http://www.imdb.com/name/nm1692812> ;
