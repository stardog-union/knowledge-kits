   rdfs:label "All Is Lost" ;
   <https://schema.org/description> "After a collision with a shipping container at sea, a resourceful sailor finds himself, despite all efforts to the contrary, staring his mortality in the face." ;
   <https://schema.org/actor> <http://www.imdb.com/name/nm0000602> ;
   <https://schema.org/author> <http://www.imdb.com/name/nm1170855> ;
