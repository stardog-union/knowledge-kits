<http://www.imdb.com/title/tt0010323> a <https://schema.org/Movie> ;
   rdfs:label "The Cabinet of Dr. Caligari" ;
   <https://schema.org/description> "Hypnotist Dr. Caligari uses a somnambulist, Cesare, to commit murders." ;
   <https://schema.org/actor> <http://www.imdb.com/name/nm0196820> , <http://www.imdb.com/name/nm0270415> , <http://www.imdb.com/name/nm0470328> , <http://www.imdb.com/name/nm0891998> ;
