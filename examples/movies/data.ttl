   rdfs:label "Youth in Revolt" ;
   <https://schema.org/description> "While his trailer trash parents teeter on the edge of divorce, Nick Twisp sets his sights on dream girl Sheeni Saunders, hoping that she'll be the one to take away his virginity." ;
   <https://schema.org/actor> <http://www.imdb.com/name/nm0000501> , <http://www.imdb.com/name/nm0234668> , <http://www.imdb.com/name/nm0148418> , <http://www.imdb.com/name/nm0005443> ;
