   rdfs:label "Faust" ;
   <https://schema.org/description> "The demon Mephisto wagers with God that he can corrupt a mortal man's soul." ;
   <https://schema.org/actor> <http://www.imdb.com/name/nm0252472> , <http://www.imdb.com/name/nm0394806> , <http://www.imdb.com/name/nm0417837> , <http://www.imdb.com/name/nm0723801> ;
