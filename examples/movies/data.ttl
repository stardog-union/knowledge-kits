   rdfs:label "The Number 23" ;
   <https://schema.org/description> "Walter Sparrow becomes obsessed with a novel that he believes was written about him. As his obsession increases, more and more similarities seem to arise." ;
   <https://schema.org/actor> <http://www.imdb.com/name/nm0000120> , <http://www.imdb.com/name/nm0000515> , <http://www.imdb.com/name/nm0503567> , <http://www.imdb.com/name/nm0396812> ;
