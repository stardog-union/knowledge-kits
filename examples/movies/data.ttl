   rdfs:label "Love & Mercy" ;
   <https://schema.org/description> "In the 1960s, Beach Boys leader Brian Wilson struggles with emerging psychosis as he attempts to craft his avant-garde pop masterpiece. In the 1980s, he is a broken, confused man under the 24-hour watch of shady therapist Dr. Eugene Landy." ;
   <https://schema.org/actor> <http://www.imdb.com/name/nm0000131> , <http://www.imdb.com/name/nm0006969> , <http://www.imdb.com/name/nm0200452> , <http://www.imdb.com/name/nm0316079> ;
