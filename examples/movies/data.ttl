   rdfs:label "Everything Is Illuminated" ;
   <https://schema.org/description> "A young Jewish American man endeavors to find the woman who saved his grandfather during World War II in a Ukrainian village, that was ultimately razed by the Nazis, with the help of an eccentric local." ;
   <https://schema.org/actor> <http://www.imdb.com/name/nm0000704> , <http://www.imdb.com/name/nm0504007> , <http://www.imdb.com/name/nm1583636> , <http://www.imdb.com/name/nm1778479> ;
