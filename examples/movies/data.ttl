   rdfs:label "The Starving Games" ;
   <https://schema.org/description> "In this Hunger Games spoof, Kantmiss Evershot must fight for her life in the 75th annual Starving Games, where she could also win an old ham, a coupon for a foot-long sub, and a partially eaten pickle." ;
   <https://schema.org/actor> <http://www.imdb.com/name/nm0101242> , <http://www.imdb.com/name/nm2118666> , <http://www.imdb.com/name/nm2301213> , <http://www.imdb.com/name/nm2421367> ;
