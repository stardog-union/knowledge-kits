   <https://schema.org/isSimilarTo> <http://www.imdb.com/title/tt0988595> , <http://www.imdb.com/title/tt1142988> , <http://www.imdb.com/title/tt1055292> , <http://www.imdb.com/title/tt0901476> , <http://www.imdb.com/title/tt0209475> , <http://www.imdb.com/title/tt0372532> , <http://www.imdb.com/title/tt0866439> , <http://www.imdb.com/title/tt1212436> , <http://www.imdb.com/title/tt0360139> , <http://www.imdb.com/title/tt1216492> , <http://www.imdb.com/title/tt0770703> , <http://www.imdb.com/title/tt0892318> ;
