   <https://schema.org/isSimilarTo> <http://www.imdb.com/title/tt0116367> , <http://www.imdb.com/title/tt1077258> , <http://www.imdb.com/title/tt0401792> , <http://www.imdb.com/title/tt1028528> , <http://www.imdb.com/title/tt0462322> , <http://www.imdb.com/title/tt0285823> , <http://www.imdb.com/title/tt0112851> , <http://www.imdb.com/title/tt0104815> , <http://www.imdb.com/title/tt2002718> , <http://www.imdb.com/title/tt0458481> ;
