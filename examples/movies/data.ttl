   rdfs:label "Bless the Child" ;
   <https://schema.org/description> "Cody, a little girl abandoned by her mother and raised by a nurse, is kidnapped. The girl's guardian, aided by an FBI agent, learn that Cody has supernatural abilities and the abductees are a Satanic cult wanting to harness her abilities." ;
   <https://schema.org/actor> <http://www.imdb.com/name/nm0000107> , <http://www.imdb.com/name/nm0001722> , <http://www.imdb.com/name/nm0001751> , <http://www.imdb.com/name/nm0171052> ;
