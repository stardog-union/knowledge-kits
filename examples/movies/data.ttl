   <https://schema.org/isSimilarTo> <http://www.imdb.com/title/tt0371746> , <http://www.imdb.com/title/tt0800369> , <http://www.imdb.com/title/tt0848228> , <http://www.imdb.com/title/tt2395427> , <http://www.imdb.com/title/tt3498820> , <http://www.imdb.com/title/tt1843866> , <http://www.imdb.com/title/tt0478970> , <http://www.imdb.com/title/tt1228705> , <http://www.imdb.com/title/tt1300854> , <http://www.imdb.com/title/tt1981115> , <http://www.imdb.com/title/tt1270798> , <http://www.imdb.com/title/tt1877832> ;
