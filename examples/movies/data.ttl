   rdfs:label "How Green Was My Valley" ;
   <https://schema.org/description> "At the turn of the century in a Welsh mining village, the Morgans, he stern, she gentle, raise coal-mining sons and hope their youngest will find a better life." ;
   <https://schema.org/actor> <http://www.imdb.com/name/nm0000058> , <http://www.imdb.com/name/nm0187981> , <http://www.imdb.com/name/nm0496819> , <http://www.imdb.com/name/nm0682074> ;
