   rdfs:label "Circle" ;
   <https://schema.org/description> "Held captive and faced with their imminent executions, fifty strangers are forced to choose the one person among them who deserves to live." ;
   <https://schema.org/actor> <http://www.imdb.com/name/nm0897425> , <http://www.imdb.com/name/nm1660148> , <http://www.imdb.com/name/nm4422265> , <http://www.imdb.com/name/nm6276713> ;
