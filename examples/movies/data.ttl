   <https://schema.org/isSimilarTo> <http://www.imdb.com/title/tt0343818> , <http://www.imdb.com/title/tt0831387> , <http://www.imdb.com/title/tt1631867> , <http://www.imdb.com/title/tt1136608> , <http://www.imdb.com/title/tt0418279> , <http://www.imdb.com/title/tt0480249> , <http://www.imdb.com/title/tt0416449> , <http://www.imdb.com/title/tt0816711> , <http://www.imdb.com/title/tt1483013> , <http://www.imdb.com/title/tt1535108> , <http://www.imdb.com/title/tt1318514> , <http://www.imdb.com/title/tt2103281> ;
