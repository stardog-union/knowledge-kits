   rdfs:label "Big Eyes" ;
   <https://schema.org/description> "A drama about the awakening of painter Margaret Keane, her phenomenal success in the 1950s, and the subsequent legal difficulties she had with her husband, who claimed credit for her works in the 1960s." ;
   <https://schema.org/actor> <http://www.imdb.com/name/nm0010736> , <http://www.imdb.com/name/nm0910607> , <http://www.imdb.com/name/nm0396812> , <http://www.imdb.com/name/nm1269983> ;
