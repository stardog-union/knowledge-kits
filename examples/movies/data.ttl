   rdfs:label "The Maltese Falcon" ;
   <https://schema.org/description> "A private detective takes on a case that involves him with three eccentric criminals, a gorgeous liar, and their quest for a priceless statuette." ;
   <https://schema.org/actor> <http://www.imdb.com/name/nm0000048> , <http://www.imdb.com/name/nm0000007> , <http://www.imdb.com/name/nm0000802> , <http://www.imdb.com/name/nm0313438> ;
