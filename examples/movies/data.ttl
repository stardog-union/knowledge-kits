   rdfs:label "Invasion of the Body Snatchers" ;
   <https://schema.org/description> "A small-town doctor learns that the population of his community is being replaced by emotionless alien duplicates." ;
   <https://schema.org/actor> <http://www.imdb.com/name/nm0002994> , <http://www.imdb.com/name/nm0233014> , <http://www.imdb.com/name/nm0309588> , <http://www.imdb.com/name/nm0944073> ;
