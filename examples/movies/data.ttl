<http://www.imdb.com/title/tt0060086> a <https://schema.org/Movie> ;
   rdfs:label "Alfie" ;
   <https://schema.org/description> "An unrepentant ladies' man gradually begins to understand the consequences of his lifestyle." ;
   <https://schema.org/actor> <http://www.imdb.com/name/nm0001859> , <http://www.imdb.com/name/nm0000323> , <http://www.imdb.com/name/nm0287905> , <http://www.imdb.com/name/nm0552815> ;
