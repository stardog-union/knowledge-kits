   rdfs:label "Kon-Tiki" ;
   <https://schema.org/description> "Legendary explorer Thor Heyerdal's epic 4,300-mile crossing of the Pacific on a balsawood raft in 1947, in an effort to prove that it was possible for South Americans to settle in Polynesia in pre-Columbian times." ;
   <https://schema.org/actor> <http://www.imdb.com/name/nm0803890> , <http://www.imdb.com/name/nm0471601> , <http://www.imdb.com/name/nm1914298> , <http://www.imdb.com/name/nm2322351> ;
