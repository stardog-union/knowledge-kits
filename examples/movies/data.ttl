<http://www.imdb.com/title/tt0059825> a <https://schema.org/Movie> ;
   rdfs:label "The Train" ;
   <https://schema.org/description> "In 1944, a German colonel loads a train with French art treasures to send to Germany. The Resistance must stop it without damaging the cargo." ;
   <https://schema.org/actor> <http://www.imdb.com/name/nm0000044> , <http://www.imdb.com/name/nm0603402> , <http://www.imdb.com/name/nm0006890> , <http://www.imdb.com/name/nm0282530> ;
