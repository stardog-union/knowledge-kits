   rdfs:label "Rab Ne Bana Di Jodi" ;
   <https://schema.org/description> "A middle-aged man who lost his love for life rediscovers it by assuming a new identity in order to rekindle the romantic spark in his marriage." ;
   <https://schema.org/actor> <http://www.imdb.com/name/nm0451321> , <http://www.imdb.com/name/nm3087728> , <http://www.imdb.com/name/nm0665555> , <http://www.imdb.com/name/nm0706954> ;
