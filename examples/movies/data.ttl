   <https://schema.org/isSimilarTo> <http://www.imdb.com/title/tt0386032> , <http://www.imdb.com/title/tt1232207> , <http://www.imdb.com/title/tt1286537> , <http://www.imdb.com/title/tt1016268> , <http://www.imdb.com/title/tt1645089> , <http://www.imdb.com/title/tt0912593> , <http://www.imdb.com/title/tt0104810> , <http://www.imdb.com/title/tt0436971> , <http://www.imdb.com/title/tt1039647> , <http://www.imdb.com/title/tt1189345> , <http://www.imdb.com/title/tt2145874> , <http://www.imdb.com/title/tt2752724> ;
