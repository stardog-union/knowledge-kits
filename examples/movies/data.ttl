   rdfs:label "The Last Castle" ;
   <https://schema.org/description> "A court-martialed general rallies together 1200 inmates to rise against the corrupt system that put him away." ;
   <https://schema.org/actor> <http://www.imdb.com/name/nm0000602> , <http://www.imdb.com/name/nm0001254> , <http://www.imdb.com/name/nm0749263> , <http://www.imdb.com/name/nm0123733> ;
