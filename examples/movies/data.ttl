   rdfs:label "Joyeux Noel" ;
   <https://schema.org/description> "In December 1914, an unofficial Christmas truce on the Western Front allows soldiers from opposing sides of the First World War to gain insight into each other's way of life." ;
   <https://schema.org/actor> <http://www.imdb.com/name/nm1208167> , <http://www.imdb.com/name/nm0299811> , <http://www.imdb.com/name/nm0133899> , <http://www.imdb.com/name/nm0221745> ;
