   <https://schema.org/keyword> "child murder investigation" , "crime investigation" , "organized crime" , "psychopath" , "serial child killer" ;
   <urn:stardog:demos:movies:rating> "8.4"^^xsd:float ;
   <urn:stardog:demos:movies:storyline> "In Germany, Hans Beckert is an unknown killer of girls. He whistles Edvard Grieg's 'In The Hall of the Mountain King', from the 'Peer Gynt' Suite I Op. 46 while attracting the little girls for death. The police force pressed by the Minister give its best effort trying unsuccessfully to arrest the serial killer. The organized crime has great losses due to the intense search and siege of the police and decides to chase the murderer, with the support of the beggars association. They catch Hans and briefly judge him." ;
   <https://schema.org/inLanguage> "German" .
<http://www.imdb.com/title/tt0033467> a <https://schema.org/Movie> ;
   rdfs:label "Citizen Kane" ;
   <https://schema.org/description> "Following the death of a publishing tycoon, news reporters scramble to discover the meaning of his final utterance." ;
   <https://schema.org/actor> <http://www.imdb.com/name/nm0000080> , <http://www.imdb.com/name/nm0001072> , <http://www.imdb.com/name/nm0001547> , <http://www.imdb.com/name/nm0173827> ;
   <https://schema.org/author> <http://www.imdb.com/name/nm0000080> , <http://www.imdb.com/name/nm0542534> ;
   <https://schema.org/director> <http://www.imdb.com/name/nm0000080> ;
   <https://schema.org/genre> "Mystery" , "Drama" ;
   <https://schema.org/contentRating> "Approved" ;
   <https://schema.org/copyrightYear> 1941 ;
   <https://schema.org/keyword> "adultery" , "materialism" , "narcissism" , "newspaper publisher" , "suicide attempt" ;
   <urn:stardog:demos:movies:rating> "8.4"^^xsd:float ;
   <urn:stardog:demos:movies:storyline> "A group of reporters are trying to decipher the last word ever spoken by Charles Foster Kane, the millionaire newspaper tycoon: \"Rosebud.\" The film begins with a news reel detailing Kane's life for the masses, and then from there, we are shown flashbacks from Kane's life. As the reporters investigate further, the viewers see a display of a fascinating man's rise to fame, and how he eventually fell off the top of the world." ;
   <https://schema.org/inLanguage> "English" .
<http://www.imdb.com/title/tt0040522> a <https://schema.org/Movie> ;
   rdfs:label "Bicycle Thieves" ;
   <https://schema.org/description> "In post-war Italy, a working-class man's bicycle is stolen. He and his son set out to find it." ;
