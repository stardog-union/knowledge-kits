   rdfs:label "The Man Who Knew Infinity" ;
   <https://schema.org/description> "The story of the life and academic career of the pioneer Indian mathematician, Srinivasa Ramanujan, and his friendship with his mentor, Professor G.H. Hardy." ;
   <https://schema.org/actor> <http://www.imdb.com/name/nm0000460> , <http://www.imdb.com/name/nm2353862> , <http://www.imdb.com/name/nm0801674> , <http://www.imdb.com/name/nm3832790> ;
   <https://schema.org/author> <http://www.imdb.com/name/nm0114226> ;
   <https://schema.org/director> <http://www.imdb.com/name/nm0114226> ;
