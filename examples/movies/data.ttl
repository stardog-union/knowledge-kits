   rdfs:label "Rambo: First Blood Part II" ;
   <https://schema.org/description> "John Rambo is released from prison by the government for a top-secret covert mission to the last place on Earth he'd want to return - the jungles of Vietnam." ;
   <https://schema.org/actor> <http://www.imdb.com/name/nm0000230> , <http://www.imdb.com/name/nm0001077> , <http://www.imdb.com/name/nm0000925> , <http://www.imdb.com/name/nm0621008> ;
