   rdfs:label "The Physician" ;
   <https://schema.org/description> "In Persia in the 11th Century, a surgeon's apprentice disguises himself as a Jew to study at a school that does not admit Christians." ;
   <https://schema.org/actor> <http://www.imdb.com/name/nm0001745> , <http://www.imdb.com/name/nm0553648> , <http://www.imdb.com/name/nm2050746> , <http://www.imdb.com/name/nm2092835> ;
