   rdfs:label "Win a Date with Tad Hamilton!" ;
   <https://schema.org/description> "A small-town girl wins a date with a male celebrity through a contest. When the date goes better than expected, a love triangle forms between the girl, the male celebrity, and the girl's best friend." ;
   <https://schema.org/actor> <http://www.imdb.com/name/nm0001447> , <http://www.imdb.com/name/nm0098378> , <http://www.imdb.com/name/nm0333410> , <http://www.imdb.com/name/nm0241049> ;
