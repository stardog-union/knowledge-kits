   rdfs:label "The Mummy: Tomb of the Dragon Emperor" ;
   <https://schema.org/description> "In the Far East, Alex O'Connell, the son of famed mummy fighters Rick and Evy O'Connell, unearths the mummy of the first Emperor of Qin -- a shape-shifting entity cursed by a witch centuries ago." ;
   <https://schema.org/actor> <http://www.imdb.com/name/nm0004742> , <http://www.imdb.com/name/nm0000409> , <http://www.imdb.com/name/nm0000706> , <http://www.imdb.com/name/nm0001472> ;
