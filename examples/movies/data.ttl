   rdfs:label "The Astronaut Farmer" ;
   <https://schema.org/description> "A NASA astronaut (Thornton), forced to retire years earlier so he could save his family farm, has never given up his dream of space travel and looks to build his own rocket, despite the government's threats to stop him." ;
   <https://schema.org/actor> <http://www.imdb.com/name/nm0001136> , <http://www.imdb.com/name/nm0000671> , <http://www.imdb.com/name/nm0000515> , <http://www.imdb.com/name/nm1302735> ;
