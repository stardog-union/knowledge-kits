   rdfs:label "Chernobyl Diaries" ;
   <https://schema.org/description> "Six tourists hire an extreme tour guide who takes them to the abandoned city Pripyat, the former home to the workers of the Chernobyl nuclear reactor. During their exploration, they soon discover they are not alone." ;
   <https://schema.org/actor> <http://www.imdb.com/name/nm0680667> , <http://www.imdb.com/name/nm0565366> , <http://www.imdb.com/name/nm1838070> , <http://www.imdb.com/name/nm2772584> ;
