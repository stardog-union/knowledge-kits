system:QueryQ10573 a system:StoredQuery , system:SharedQuery ;
  system:queryName "Q10573" ;
  system:queryDatabase "kit-c360" ;
  system:queryCreator "unknown" ;
  system:voiceboxQuestion "Sales per items in 2022?", "Sales Total per item in 2022?" ;
  system:queryString """SELECT ?item ?vendor0 (SUM(?purchasePrice) AS ?sales) 
WHERE {

  {
    SELECT ?purchasePrice ?item ?vendor0 
    WHERE {
      ?order ecomm:itemPurchased ?item . 
      ?order ecomm:purchasePrice ?purchasePrice . 

      {
        SELECT ?order ?purchasePrice ?item 
        WHERE {
          ?order ecomm:purchaseDate ?purchaseDate . 
          BIND("2022-01-01"^^xsd:date AS ?start)
          BIND("2022-12-31"^^xsd:date AS ?end)
          FILTER (?purchaseDate >= ?start)
          FILTER (?purchaseDate <= ?end)
        }
      }
      ?item ecomm:vendor ?vendor0 . 
    }
  }
}
GROUP BY ?item ?vendor0""".
