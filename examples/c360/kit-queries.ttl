  system:queryString """SELECT (MAX(?total) AS ?max) 
WHERE {

  {
    SELECT (SUM(?price) AS ?total) 
    WHERE {
      ?order0 a ecomm:Order . 
      ?order0 ecomm:purchaseDate ?date . 
      ?order0 ecomm:purchasePrice ?price . 
    }
    GROUP BY ?date
  }
}""".
system:QueryQ11004 a system:StoredQuery , system:SharedQuery ;
  system:queryName "Q11004" ;
  system:queryDatabase "kit-c360" ;
  system:queryCreator "unknown" ;
  system:voiceboxQuestion "Which products are purchased by the most customers?", "Which products sold to the most customers?", "What is the name of the products with the highest sold-to customer count?", "Which products have orders with the most distinct customers?" ;
  system:queryString """SELECT ?product0 
WHERE {

  {
    SELECT ?product0 (COUNT(DISTINCT ?customer) AS ?count) 
    WHERE {
      ?order0 a ecomm:Order . 
      ?order0 ecomm:itemPurchased ?product0 . 
      ?order0 ecomm:purchasedBy ?customer . 
      ?product0 a ecomm:Product . 
    }
    GROUP BY ?product0
  }

  {
    SELECT (COUNT(DISTINCT ?customer) AS ?count) 
    WHERE {
      ?order0 a ecomm:Order . 
      ?order0 ecomm:itemPurchased ?product0 . 
      ?order0 ecomm:purchasedBy ?customer . 
      ?product0 a ecomm:Product . 
    }
    GROUP BY ?product0
    ORDER BY     DESC(?count)
    LIMIT 1
  }
}""".
