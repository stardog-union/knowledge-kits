  system:voiceboxQuestion "Find the decreasing order of customer count by zip code", "customer count by zip code in descending order", "descending count of customers by zip code", "Find the decreasing order of customer count by postal code", "customer count by postal code in descending order", "descending count of customers by postal code" ;
  system:queryString """SELECT ?zipCode (COUNT(DISTINCT ?customer0) AS ?customerCount) 
WHERE {
