  system:voiceboxQuestion "List sales per vendor and category in 2022?", "Show total sales for each vendor and product category in 2022?" ;
  system:queryString """SELECT ?name0 ?name1 (SUM(?purchasePrice) AS ?sales) 
WHERE {
  ?order ecomm:itemPurchased ?item . 
  ?order ecomm:purchaseDate ?purchaseDate . 
  ?order ecomm:purchasePrice ?purchasePrice . 
  ?item ecomm:inCategory ?cat . 
  ?item ecomm:vendor ?vendor0 . 
  ?cat ecomm:name ?name1 . 
  ?vendor0 ecomm:name ?name0 . 
  FILTER ("2022-01-01"^^xsd:date <= ?purchaseDate)
  FILTER ("2022-12-31"^^xsd:date >= ?purchaseDate)
}
GROUP BY ?name0 ?name1
ORDER BY DESC(?sales)""".
