system:QueryQ10551 a system:StoredQuery , system:SharedQuery , system:ReasoningQuery ;
  system:queryName "Q10551" ;
  system:queryDatabase "kit-c360" ;
  system:queryCreator "unknown" ;
  system:voiceboxQuestion "Which customers have a rewards account that was opened on or before November 2nd, 2015?" ;
  system:queryString """SELECT DISTINCT ?customer0 ?rewardsAccount0 
WHERE {
  ?customer0 a ecomm:Customer . 
  ?customer0 ecomm:hasRewards ?rewardsAccount0 . 
  ?rewardsAccount0 a ecomm:RewardsAccount . 
  ?rewardsAccount0 ecomm:openDate ?dat_0 . 
  FILTER ("2015-11-02"^^xsd:date >= ?dat_0)
}""".
system:QueryQ10552 a system:StoredQuery , system:SharedQuery ;
  system:queryName "Q10552" ;
  system:queryDatabase "kit-c360" ;
  system:queryCreator "unknown" ;
  system:voiceboxQuestion "What is the percentage of customers that have rewards?", "Find the percentage of customers having rewards?" ;
  system:queryString """SELECT (((?customersWithRewards / ?customers) * "100"^^xsd:integer) AS ?percent) 
WHERE {

  {
    SELECT (COUNT(?customer0) AS ?customersWithRewards) 
    WHERE {
      ?customer0 a ecomm:Customer . 
      ?customer0 ecomm:hasRewards ?rewards0 . 
    }
  }

  {
    SELECT (COUNT(?customer0) AS ?customers) 
    WHERE {
      ?customer0 a ecomm:Customer . 
    }
  }
}""".
