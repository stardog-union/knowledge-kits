system:QueryQ10696 a system:StoredQuery , system:SharedQuery , system:ReasoningQuery ;
  system:queryName "Q10696" ;
  system:queryDatabase "kit-c360" ;
  system:queryCreator "unknown" ;
  system:voiceboxQuestion "What products are from the vendor Apple or are electronics more than $500?", "Find all products from Apple or electronics that list MSRP over $500" ;
  system:queryString """SELECT DISTINCT ?product0 ?unitPrice0 ?vendor0 
WHERE {

  {
    ?product0 a ecomm:Product . 
    ?product0 ecomm:inCategory ?category0 . 
    ?product0 ecomm:msrp ?unitPrice0 . 
    ?unitPrice0 a ecomm:UnitPrice . 
    ?unitPrice0 ecomm:hasPrice ?price0 . 
    ?category0 a ecomm:Category . 
    ?category0 ecomm:name ?name0 . 
    ?name0 stardog:property:textMatch "Electronics" . 
    FILTER ("500"^^xsd:float < ?price0)
  }
  UNION {
    ?product0 a ecomm:Product . 
    ?product0 ecomm:inCategory ?category1 . 
    ?product0 ecomm:vendor ?vendor0 . 
    ?vendor0 a ecomm:Vendor . 
    ?vendor0 ecomm:name ?name1 . 
    ?name1 stardog:property:textMatch "Apple" . 
    ?category1 a ecomm:Category . 
    ?category1 ecomm:name ?name2 . 
    ?name2 stardog:property:textMatch "Electronics" . 
  }
}""".
