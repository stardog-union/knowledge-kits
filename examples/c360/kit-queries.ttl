system:QueryQ10582 a system:StoredQuery , system:SharedQuery ;
  system:queryName "Q10582" ;
  system:queryDatabase "kit-c360" ;
  system:queryCreator "unknown" ;
  system:voiceboxQuestion "What 3 products sold for the most total revenue in 2022. Inclde the product name and the revenue. Order by total revenue.", "List top 3 products that sold for the most total revenue in 2020." ;
  system:queryString """SELECT ?product (SUM(?price) AS ?total) 
WHERE {
  ?order0 a ecomm:Order . 
  ?order0 ecomm:itemPurchased ?product . 
  ?order0 ecomm:purchaseDate ?date . 
  ?order0 ecomm:purchasePrice ?price . 
  FILTER ("2022"^^xsd:integer = YEAR(?date))
}
GROUP BY ?product
ORDER BY DESC(?total)
LIMIT 3""".
