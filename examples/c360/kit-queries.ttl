system:QueryQ10604 a system:StoredQuery , system:SharedQuery ;
  system:queryName "Q10604" ;
  system:queryDatabase "kit-c360" ;
  system:queryCreator "unknown" ;
  system:voiceboxQuestion "Sales per state in 2022?", "Sales total per state in 2022?", "Sales per state in 2022?", "Sales total per state in 2022?" ;
  system:queryString """SELECT ?state0 (SUM(?purchasePrice) AS ?sales) 
WHERE {
  ?order ecomm:purchasePrice ?purchasePrice . 
  ?order ecomm:purchasedBy ?customer . 

  {

    {
      ?order ecomm:purchaseDate ?purchaseDate . 
    BIND("2022-01-01"^^xsd:date AS ?start)
    }
  BIND("2022-12-31"^^xsd:date AS ?end)
  }
  ?customer ecomm:address ?address0 . 
  ?address0 ecomm:state ?state0 . 
  FILTER (?purchaseDate >= ?start)
  FILTER (?purchaseDate <= ?end)
}
GROUP BY ?state0""".
