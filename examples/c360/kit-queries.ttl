  ?dat_0 stardog:property:textMatch "americanexpress" . 
  FILTER ("2018-01-01"^^xsd:date > ?dat_1)
}""".
system:QueryQ11152 a system:StoredQuery , system:SharedQuery ;
  system:queryName "Q11152" ;
  system:queryDatabase "kit-c360" ;
  system:queryCreator "unknown" ;
  system:voiceboxQuestion "Which customers purchased baseball gloves?", "Find me all the customers who purchased a baseball glove." ;
