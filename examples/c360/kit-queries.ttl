  system:queryDatabase "kit-c360" ;
  system:queryCreator "unknown" ;
  system:voiceboxQuestion "Of which product have we sold more than 5 units this year?", "Tell me which product we sold more than 5 units this calendar year?" ;
  system:queryString """SELECT ?product (SUM(?quantity0) AS ?totalQuantity) 
WHERE {
  ?order0 a ecomm:Order . 
  ?order0 ecomm:itemPurchased ?product . 
  ?order0 ecomm:purchaseDate ?purchaseDate . 
  ?order0 ecomm:quantity ?quantity0 . 
  FILTER (("2023-01-01"^^xsd:date <= ?purchaseDate && "2023-12-31"^^xsd:date >= ?purchaseDate))
}
GROUP BY ?product
HAVING("5"^^xsd:integer < ?totalQuantity)
ORDER BY (?totalQuantity)""".
