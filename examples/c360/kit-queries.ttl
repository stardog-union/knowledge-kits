system:QueryQ11020 a system:StoredQuery , system:SharedQuery ;
  system:queryName "Q11020" ;
  system:queryDatabase "kit-c360" ;
  system:queryCreator "unknown" ;
  system:voiceboxQuestion "total number of blenders purchased in 2017.", "total number of blenders bought in 2017.", "how many blenders were purchased in 2017?", "how many blenders were bought in 2017?", "find the total quanity of blenders purchased in 2017.", "find the total quanity of blenders bought in 2017." ;
  system:queryString """SELECT (SUM(?quantity0) AS ?totalQuantity) 
WHERE {

  {
    ?order0 a ecomm:Order . 
    ?order0 ecomm:itemPurchased ?product0 . 
    ?order0 ecomm:purchaseDate ?purchaseDate . 
    ?order0 ecomm:quantity ?quantity0 . 
    ?product0 a ecomm:Product . 
    ?product0 ecomm:name ?name0 . 
  BIND(YEAR(?purchaseDate) AS ?purchaseYear)
  }
  ?name0 stardog:property:textMatch "Blender" . 
  FILTER (?purchaseYear = "2017"^^xsd:integer)
}""".
system:QueryQ11026 a system:StoredQuery , system:SharedQuery ;
  system:queryName "Q11026" ;
  system:queryDatabase "kit-c360" ;
  system:queryCreator "unknown" ;
  system:voiceboxQuestion "Which are the two best selling years for furniture?", "In which two years did companies from the furniture sector achieve the highest revenue?" ;
  system:queryString """SELECT ?year 
WHERE {

  {
    SELECT ?year (SUM(?price) AS ?totalRevenue) 
    WHERE {
      ?order ecomm:itemPurchased ?_anon_1 . 
      ?order ecomm:purchaseDate ?date . 
      ?order ecomm:purchasePrice ?price . 
      ?_anon_1 ecomm:vendor ?vendor0 . 
      ?vendor0 ecomm:industry ?industry0 . 
      ?industry0 stardog:label "Furniture" . 
      BIND(xsd:integer(SUBSTR(Str(?date), "0"^^xsd:integer, "5"^^xsd:integer)) AS ?year)
    }
    GROUP BY ?year
  }
}
ORDER BY DESC(?totalRevenue)
LIMIT 2""".
