system:QueryQ10674 a system:StoredQuery , system:SharedQuery ;
  system:queryName "Q10674" ;
  system:queryDatabase "kit-c360" ;
  system:queryCreator "unknown" ;
  system:voiceboxQuestion "What is the most common order price in 2018?", "For the year 2018, for is the mode of the order price?" ;
  system:queryString """SELECT ?price 
WHERE {
  ?order0 a ecomm:Order . 
  ?order0 ecomm:purchaseDate ?date . 
  ?order0 ecomm:purchasePrice ?price . 
  FILTER ("2018"^^xsd:integer = YEAR(?date))
}
GROUP BY ?price
ORDER BY DESC(COUNT(?order0))
LIMIT 1""".
