system:QueryQ11090 a system:StoredQuery , system:SharedQuery ;
  system:queryName "Q11090" ;
  system:queryDatabase "kit-c360" ;
  system:queryCreator "unknown" ;
  system:voiceboxQuestion "Which vendor had the best sales in the Electronic category in 2022?", "which electonic vendor had the best sales in 2022?" ;
  system:queryString """SELECT ?vendor0 (SUM(DISTINCT ?purchasePrice) AS ?sales) 
WHERE {
  ?order0 a ecomm:Order . 
  ?order0 ecomm:itemPurchased ?item . 
  ?order0 ecomm:purchaseDate ?purchaseDate . 
  ?order0 ecomm:purchasePrice ?purchasePrice . 
  ?item ecomm:inCategory ?category0 . 
  ?item ecomm:vendor ?vendor0 . 
  ?category0 ecomm:name ?name0 . 
  ?name0 stardog:property:textMatch "Electronics" . 
  FILTER ("2022"^^xsd:integer = YEAR(?purchaseDate))
}
GROUP BY ?vendor0
ORDER BY DESC(?sales)
LIMIT 1""".
