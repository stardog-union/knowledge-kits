system:QueryQ10786 a system:StoredQuery , system:SharedQuery ;
  system:queryName "Q10786" ;
  system:queryDatabase "kit-c360" ;
  system:queryCreator "unknown" ;
  system:voiceboxQuestion "Which 10 products sold for the highest discount in 2022. Include product name, MSRP (in USD), unit price, and discount.", "Rank products by 1 minus their order price divided by their MSRP (in USD). Call this calculation \"discount\" List the 10 with the highest value. Include product name, unit price, MSRP, and discount." ;
  system:queryString """SELECT ?product0 ?unitPrice ?price0 ?discount 
WHERE {
  ?order0 a ecomm:Order . 
  ?order0 ecomm:itemPurchased ?product0 . 
  ?order0 ecomm:purchaseDate ?date . 
  ?order0 ecomm:purchasePrice ?price . 
  ?order0 ecomm:quantity ?quantity0 . 
  ?product0 a ecomm:Product . 
  ?product0 ecomm:msrp ?msrp0 . 
  ?msrp0 ecomm:hasCurrency "USD" . 
  ?msrp0 ecomm:hasPrice ?price0 . 
  BIND((?price / ?quantity0) AS ?unitPrice)
  BIND(("1"^^xsd:integer - (?unitPrice / ?price0)) AS ?discount)
  FILTER ("2022"^^xsd:integer = YEAR(?date))
}
ORDER BY DESC(?discount)
LIMIT 10""".
