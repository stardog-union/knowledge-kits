  system:queryDatabase "kit-c360" ;
  system:queryCreator "unknown" ;
  system:voiceboxQuestion "List the top 15 states with the highest sales in 2020. Include the state and the total revenue.", "Customers from which 15 states have orders with the highest total sales in the year 2020?", "What are the top 15 states from which customers have orders with the highest total sales in the year 2020?" ;
  system:queryString """SELECT ?state0 (SUM(?price) AS ?total) 
WHERE {
  ?order0 a ecomm:Order . 
  ?order0 ecomm:purchaseDate ?date . 
  ?order0 ecomm:purchasePrice ?price . 
  ?order0 ecomm:purchasedBy ?customer . 
  ?customer ecomm:address ?address0 . 
  ?address0 ecomm:state ?state0 . 
  FILTER ("2020"^^xsd:integer = YEAR(?date))
}
GROUP BY ?state0
ORDER BY DESC(?total)
LIMIT 15""".
system:QueryQ11082 a system:StoredQuery , system:SharedQuery ;
  system:queryName "Q11082" ;
  system:queryDatabase "kit-c360" ;
  system:queryCreator "unknown" ;
  system:voiceboxQuestion "what is the percentage of customers with rewards accounts?", "find the percentage of customers who have rewards accounts.", "percentage of customers with a rewards account." ;
  system:queryString """SELECT (("100"^^xsd:integer * (?rewardsAccountCount / ?customerCount)) AS ?percentage) 
WHERE {

  {
    SELECT (COUNT(DISTINCT ?customer0) AS ?rewardsAccountCount) 
    WHERE {
      ?customer0 a ecomm:Customer . 
      ?customer0 ecomm:hasRewards ?rewards0 . 
    }
  }

  {
    SELECT (COUNT(DISTINCT ?customer0) AS ?customerCount) 
    WHERE {
      ?customer0 a ecomm:Customer . 
    }
  }
}""".
