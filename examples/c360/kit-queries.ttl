system:QueryQ10803 a system:StoredQuery , system:SharedQuery ;
  system:queryName "Q10803" ;
  system:queryDatabase "kit-c360" ;
  system:queryCreator "unknown" ;
  system:voiceboxQuestion "Which vendor has the most customers?", "Which vendor sold to the most customers?", "What is the name of the vendor with the highest sold-to customer count?", "Which vendor sells products with orders having the most distinct customers?" ;
  system:queryString """SELECT ?vendor0 (COUNT(DISTINCT ?customer) AS ?customerCount) 
WHERE {
  ?order0 a ecomm:Order . 
  ?order0 ecomm:itemPurchased ?product0 . 
  ?order0 ecomm:purchasedBy ?customer . 
  ?product0 a ecomm:Product . 
  ?product0 ecomm:vendor ?vendor0 . 
  ?vendor0 a ecomm:Vendor . 
  ?vendor0 ecomm:name ?name0 . 
}
GROUP BY ?vendor0
ORDER BY DESC(?customerCount)
LIMIT 1""".
