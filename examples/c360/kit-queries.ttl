system:QueryQ10809 a system:StoredQuery , system:SharedQuery ;
  system:queryName "Q10809" ;
  system:queryDatabase "kit-c360" ;
  system:queryCreator "unknown" ;
  system:voiceboxQuestion "What was the address of the larest order of 2019.", "For 2019, find the largest order and return the address of the customer that placed it." ;
  system:queryString """SELECT DISTINCT ?address0 
WHERE {

  {
    SELECT ?order0 
    WHERE {
      ?order0 a ecomm:Order . 
      ?order0 ecomm:purchasePrice ?price . 
    }
    ORDER BY     DESC(?price)
    LIMIT 1
  }
  ?order0 ecomm:purchasedBy ?customer . 
  ?customer ecomm:address ?address0 . 
}""".
system:QueryQ10811 a system:StoredQuery , system:SharedQuery ;
  system:queryName "Q10811" ;
  system:queryDatabase "kit-c360" ;
  system:queryCreator "unknown" ;
  system:voiceboxQuestion "Top 3 categories in 2022", "Leading categories in terms of sales in 2022" ;
  system:queryString """SELECT ?cat (SUM(?purchasePrice) AS ?sales) 
WHERE {
  ?order ecomm:itemPurchased ?item . 
  ?order ecomm:purchaseDate ?purchaseDate . 
  ?order ecomm:purchasePrice ?purchasePrice . 
  ?item ecomm:inCategory ?cat . 
  FILTER ("2022-01-01"^^xsd:date <= ?purchaseDate)
  FILTER ("2022-12-31"^^xsd:date >= ?purchaseDate)
}
GROUP BY ?cat
ORDER BY DESC(?sales)
LIMIT 3""".
