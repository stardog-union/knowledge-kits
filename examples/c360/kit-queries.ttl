  ?unitPrice0 ecomm:hasPrice ?price0 . 
  ?category0 a ecomm:Category . 
  ?product1 a ecomm:Product . 
  ?product1 ecomm:inCategory ?category1 . 
  ?product1 ecomm:msrp ?msrp0 . 
  ?msrp0 a ecomm:UnitPrice . 
  ?msrp0 ecomm:hasPrice ?price2 . 
  ?msrp0 ecomm:hasPrice ?price1 . 
  ?category1 a ecomm:Category . 
  ?category1 ecomm:name ?name0 . 
  ?name0 stardog:property:textMatch "Appliances" . 
  FILTER (?price0 > ?price1)
  FILTER ("50"^^xsd:float < ?price2)
  FILTER ((?product0 != ?product1 && (?unitPrice0 != ?msrp0 && ?category1 != ?category0)))
}""".
