  system:queryCreator "unknown" ;
  system:voiceboxQuestion "Find all the Lithuanians from Texas who are big spenders with a rewards account" ;
  system:queryString """SELECT DISTINCT ?bigSpender0 ?address0 ?rewardsAccount0 
WHERE {
  ?bigSpender0 a ecomm:Big_Spender . 
  ?bigSpender0 ecomm:address ?address0 . 
  ?bigSpender0 ecomm:hasRewards ?rewardsAccount0 . 
  ?bigSpender0 ecomm:language ?language0 . 
  ?rewardsAccount0 a ecomm:RewardsAccount . 
  ?rewardsAccount0 ecomm:openDate ?dat_1 . 
