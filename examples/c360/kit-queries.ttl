system:QueryQ10840 a system:StoredQuery , system:SharedQuery ;
  system:queryName "Q10840" ;
  system:queryDatabase "kit-c360" ;
  system:queryCreator "unknown" ;
  system:voiceboxQuestion "In which states do we sell products that are worth at least 10 percent of our total revenue?", "Which states account for at least 10 percent of the total revenue?" ;
  system:queryString """SELECT ?state0 
WHERE {

  {
    SELECT ?state0 (SUM(?price) AS ?totalPrice) 
    WHERE {
      ?order0 ecomm:purchasePrice ?price . 
      ?order0 ecomm:purchasedBy ?customer0 . 
      ?customer0 a ecomm:Customer . 
      ?customer0 ecomm:address ?address0 . 
      ?address0 ecomm:state ?state0 . 
    }
    GROUP BY ?state0
  }

  {
    SELECT (SUM(?price) AS ?total) 
    WHERE {
      ?order0 a ecomm:Order . 
      ?order0 ecomm:purchasePrice ?price . 
    }
  }
  FILTER ("0.1"^^xsd:decimal < (?totalPrice / ?total))
}""".
