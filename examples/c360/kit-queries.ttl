    WHERE {
      ?customer0 a ecomm:Customer . 
      ?customer0 ecomm:address ?address0 . 
      ?address0 ecomm:state ?state0 . 
    }
    GROUP BY ?state0
  }

  {
    SELECT (COUNT(?customer1) AS ?total) 
    WHERE {
      ?customer1 a ecomm:Customer . 
    }
  }
}""".
