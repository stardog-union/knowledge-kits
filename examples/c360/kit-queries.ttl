@prefix stardog: <tag:stardog:api:> .
@prefix system: <http://system.stardog.com/> .

system:QueryQ10544 a system:StoredQuery , system:SharedQuery ;
  system:queryName "Q10544" ;
  system:queryDatabase "kit-c360" ;
  system:queryCreator "unknown" ;
  system:voiceboxQuestion "What products have a retail price less than one dollar?", "List the products that cost less than a dollar." ;
  system:queryString """SELECT DISTINCT ?product0 
WHERE {
  ?product0 a ecomm:Product . 
  ?product0 ecomm:msrp ?unitPrice0 . 
  ?unitPrice0 a ecomm:UnitPrice . 
  ?unitPrice0 ecomm:hasPrice ?price0 . 
  FILTER ("1.00"^^xsd:float > ?price0)
}""".
system:QueryQ10546 a system:StoredQuery , system:SharedQuery ;
  system:queryName "Q10546" ;
  system:queryDatabase "kit-c360" ;
  system:queryCreator "unknown" ;
  system:voiceboxQuestion "What customers placed an order for at least $10,000 and also had a rewards account?", "Which rewards account customers bought at least $10K in a single order?" ;
  system:queryString """SELECT DISTINCT ?customer0 
WHERE {
  ?order0 a ecomm:Order . 
  ?order0 ecomm:purchasePrice ?dat_0 . 
  ?order0 ecomm:purchasedBy ?customer0 . 
  ?customer0 a ecomm:Customer . 
  ?customer0 ecomm:hasRewards ?rewardsAccount0 . 
  ?rewardsAccount0 a ecomm:RewardsAccount . 
  FILTER ("10000.00"^^xsd:decimal <= ?dat_0)
}""".
system:QueryQ10548 a system:StoredQuery , system:SharedQuery , system:ReasoningQuery ;
  system:queryName "Q10548" ;
  system:queryDatabase "kit-c360" ;
  system:queryCreator "unknown" ;
  system:voiceboxQuestion "Find the American Express credit cards used by reward account members who ordered more than 20 items in an order" ;
  system:queryString """SELECT DISTINCT ?creditCard0 
WHERE {
  ?creditCard0 a ecomm:CreditCard . 
  ?creditCard0 ecomm:cardHolder ?customer0 . 
  ?creditCard0 ecomm:cardType ?dat_0 . 
  ?customer0 a ecomm:Customer . 
  ?customer0 ecomm:hasRewards ?rewardsAccount0 . 
  ?rewardsAccount0 a ecomm:RewardsAccount . 
  ?dat_0 stardog:property:textMatch "americanexpress" . 
  ?order0 a ecomm:Order . 
  ?order0 ecomm:quantity ?quantity0 . 
  ?order0 ecomm:rewardsAccountUsed ?rewardsAccount0 . 
  FILTER ("20"^^xsd:integer < ?quantity0)
}""".
