system:QueryQ10793 a system:StoredQuery , system:SharedQuery ;
  system:queryName "Q10793" ;
  system:queryDatabase "kit-c360" ;
  system:queryCreator "unknown" ;
  system:voiceboxQuestion "Show me all products that are Arts and Crafts costing more than $50 and Appliances costing more than $100.", "What are the Appliances and Arts and Crafts which are more than $100 and $50, respectively?" ;
  system:queryString """SELECT DISTINCT ?unitPrice0 ?product0 ?category0 ?product1 ?category1 
WHERE {

  {
    ?product0 a ecomm:Product . 
    ?product0 ecomm:inCategory ?category0 . 
    ?product0 ecomm:msrp ?unitPrice0 . 
    ?unitPrice0 a ecomm:UnitPrice . 
    ?unitPrice0 ecomm:hasPrice ?price0 . 
    ?category0 a ecomm:Category . 
    ?category0 ecomm:name ?name0 . 
    ?name0 stardog:property:textMatch "Arts and Crafts" . 
    FILTER ("50"^^xsd:float < ?price0)
  }
  UNION {
    ?product1 a ecomm:Product . 
    ?product1 ecomm:inCategory ?category1 . 
    ?product1 ecomm:msrp ?unitPrice0 . 
    ?category1 a ecomm:Category . 
    ?category1 ecomm:name ?name1 . 
    ?name1 stardog:property:textMatch "Appliances" . 
    ?unitPrice0 a ecomm:UnitPrice . 
    ?unitPrice0 ecomm:hasPrice ?price1 . 
    FILTER ("100"^^xsd:float < ?price1)
  }
}""".
