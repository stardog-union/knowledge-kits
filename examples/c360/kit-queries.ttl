system:QueryQ10639 a system:StoredQuery , system:SharedQuery ;
  system:queryName "Q10639" ;
  system:queryDatabase "kit-c360" ;
  system:queryCreator "unknown" ;
  system:voiceboxQuestion "Sales per customers in 2022?", "Sales Total per customers in 2022?" ;
  system:queryString """SELECT ?customer0 (SUM(?purchasePrice) AS ?sales) 
WHERE {
  ?order ecomm:purchaseDate ?purchaseDate . 
  ?order ecomm:purchasePrice ?purchasePrice . 
  ?order ecomm:purchasedBy ?customer0 . 
  ?customer0 a ecomm:Customer . 
  BIND("2022-01-01"^^xsd:date AS ?start)
  BIND("2022-12-31"^^xsd:date AS ?end)
  FILTER (?purchaseDate >= ?start)
  FILTER (?purchaseDate <= ?end)
}
GROUP BY ?customer0""".
