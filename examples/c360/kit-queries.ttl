  system:voiceboxQuestion "Find the most popular credit card type for making purchases", "What is the more popular credit card used for purchases?" ;
  system:queryString """SELECT ?type (COUNT(DISTINCT ?order) AS ?orders) 
WHERE {
  ?order ecomm:cardUsed ?creditCard0 . 
  ?creditCard0 a ecomm:CreditCard . 
  ?creditCard0 ecomm:cardType ?type . 
}
GROUP BY ?type
ORDER BY DESC(?orders)
LIMIT 1""".
