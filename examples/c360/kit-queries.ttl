system:QueryQ10927 a system:StoredQuery , system:SharedQuery ;
  system:queryName "Q10927" ;
  system:queryDatabase "kit-c360" ;
  system:queryCreator "unknown" ;
  system:voiceboxQuestion "List sales by year, partitioned by whether the customer used a rewards account", "For each year, list the total sales for customers that used a rewards account and total sales for customers that didn't use a rewards account" ;
  system:queryString """SELECT ?year (SUM(?rewardsSale) AS ?rewardsSales) (SUM(?noRewardsSale) AS ?noRewardsSales) 
WHERE {
  ?order0 a ecomm:Order . 
  ?order0 ecomm:purchaseDate ?date . 
  ?order0 ecomm:purchasePrice ?price . 
  ?order0 ecomm:purchasedBy ?customer . 

  OPTIONAL {
    ?order0 ecomm:rewardsAccountUsed ?rewardsAccount . 
  }
  BIND(YEAR(?date) AS ?year)
  BIND(IF(Bound(?rewardsAccount), ?price, "0.0"^^xsd:float) AS ?rewardsSale)
  BIND(IF(Bound(?rewardsAccount), "0.0"^^xsd:float, ?price) AS ?noRewardsSale)
}
GROUP BY ?year""".
