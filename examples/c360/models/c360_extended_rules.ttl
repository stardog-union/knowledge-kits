_:2ebfad87-53d7-462e-987f-4d2637346962 a rule:SPARQLRule ;
  rdfs:label "customers who made purchases in 2022" ;
  rule:content """IF {
  ?sub a stardog:ecomm:Customer .
  ?obj_0 stardog:ecomm:purchasedBy ?sub . ?obj_0 a stardog:ecomm:2022_Order .
}
THEN {
  ?sub rdf:type stardog:ecomm:2022_Orderer .
}""" ;
  <tag:stardog:designer:rule:content> """IF {
  ?sub a stardog:ecomm:Customer .
  ?obj_0 stardog:ecomm:purchasedBy ?sub . ?obj_0 a stardog:ecomm:2022_Order .
}
THEN {
  ?sub rdf:type stardog:ecomm:2022_Orderer .
}""" ;
