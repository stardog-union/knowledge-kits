_:17f0c250-bb6c-4972-a2a4-0a71162c1735 a rule:SPARQLRule ;
  rdfs:label "2022 orders" ;
  rule:content """IF {
  ?sub a stardog:ecomm:Order .
  ?sub stardog:ecomm:purchaseDate ?dat_0 . FILTER(?dat_0 >= \"2022-01-01\"^^xsd:date && ?dat_0 <= \"2022-12-31\"^^xsd:date) .
}
THEN {
  ?sub rdf:type stardog:ecomm:2022_Order .
}""" ;
  <tag:stardog:designer:rule:content> """IF {
  ?sub a stardog:ecomm:Order .
  ?sub stardog:ecomm:purchaseDate ?dat_0 . FILTER(?dat_0 >= \"2022-01-01\"^^xsd:date && ?dat_0 <= \"2022-12-31\"^^xsd:date) .
}
THEN {
  ?sub rdf:type stardog:ecomm:2022_Order .
}""" ;
