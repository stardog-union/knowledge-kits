_:f179bbd7-96a2-48c8-9543-6e0ff8e354e4 a rule:SPARQLRule ;
  rdfs:label "big spenders" ;
  rule:content """IF {
  ?sub a stardog:ecomm:Customer .
  ?obj_0 stardog:ecomm:purchasedBy ?sub . ?obj_0 a stardog:ecomm:Large_Order .
}
THEN {
  ?sub rdf:type stardog:ecomm:Big_Spender .
}""" ;
  <tag:stardog:designer:rule:content> """IF {
  ?sub a stardog:ecomm:Customer .
  ?obj_0 stardog:ecomm:purchasedBy ?sub . ?obj_0 a stardog:ecomm:Large_Order .
}
THEN {
  ?sub rdf:type stardog:ecomm:Big_Spender .
}""" ;
