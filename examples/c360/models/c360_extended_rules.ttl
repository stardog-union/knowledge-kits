_:b8ba434e-ad00-4ecc-aad3-272397ff6d96 a rule:SPARQLRule ;
  rdfs:label "large purchases" ;
  rule:content """IF {
  ?sub a stardog:ecomm:Order .
  ?sub stardog:ecomm:purchasePrice ?dat_0 . FILTER(?dat_0 > \"250\"^^xsd:decimal) .
}
THEN {
  ?sub rdf:type stardog:ecomm:Large_Order .
}""" ;
  <tag:stardog:designer:rule:content> """IF {
  ?sub a stardog:ecomm:Order .
  ?sub stardog:ecomm:purchasePrice ?dat_0 . FILTER(?dat_0 > \"250\"^^xsd:decimal) .
}
THEN {
  ?sub rdf:type stardog:ecomm:Large_Order .
}""" ;
