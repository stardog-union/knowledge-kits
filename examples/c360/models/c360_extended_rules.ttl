_:24be2cff-814e-4e44-8470-d95ef4753f39 a rule:SPARQLRule ;
  rdfs:label "sport category shopper" ;
  rule:content """IF {
  ?sub a stardog:ecomm:Customer .
  ?obj_0 stardog:ecomm:purchasedBy ?sub . ?obj_0 a stardog:ecomm:Order .
  ?obj_0 stardog:ecomm:itemPurchased ?obj_1 . ?obj_1 a stardog:ecomm:Product .
  ?obj_1 stardog:ecomm:inCategory <urn:stardog:demos:c360:category:10> . <urn:stardog:demos:c360:category:10> a stardog:ecomm:Category .
}
THEN {
  ?sub rdf:type stardog:ecomm:Sports_Category_Shopper .
}""" ;
  <tag:stardog:designer:rule:content> """IF {
  ?sub a stardog:ecomm:Customer .
  ?obj_0 stardog:ecomm:purchasedBy ?sub . ?obj_0 a stardog:ecomm:Order .
  ?obj_0 stardog:ecomm:itemPurchased ?obj_1 . ?obj_1 a stardog:ecomm:Product .
  ?obj_1 stardog:ecomm:inCategory <urn:stardog:demos:c360:category:10> . <urn:stardog:demos:c360:category:10> a stardog:ecomm:Category .
}
THEN {
  ?sub rdf:type stardog:ecomm:Sports_Category_Shopper .
}""" ;
