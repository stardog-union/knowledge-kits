system:QueryQ10521 a system:StoredQuery , system:SharedQuery ;
   system:queryName "Q10521" ;
   system:queryString """SELECT DISTINCT ?truck0 
WHERE {
  ?sensor0 a scm:Sensor . 
  ?sensor0 scm:monitors ?truck0 . 
  ?truck0 a scm:Truck . 
}""" ;
   system:queryCreator "unknown" ;
   system:queryDatabase "kit-beer" ;
   system:voiceboxQuestion "Which trucks are monitored by sensors?" , "List the trucks that are monitored by sensors by name" , "List the trucks that have sensors" , "What are the names of the trucks that have sensors?" , "List the trucks that are monitored by sensors" .
