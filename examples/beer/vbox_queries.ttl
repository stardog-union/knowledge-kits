system:QueryQ10532 a system:StoredQuery , system:SharedQuery ;
   system:queryName "Q10532" ;
   system:queryString """SELECT ?consumer0 ?sellingPoint0 ?skid0 ?product0 ?productionOutput0 ?kegFiller0 ?sensor0 
WHERE {
  ?consumer0 a scm:Consumer . 
  ?consumer0 scm:buysFrom ?sellingPoint0 . 
  ?sellingPoint0 a scm:Selling_Point . 
  ?sensor0 a scm:Sensor . 
  ?sensor0 scm:monitors ?kegFiller0 . 
  ?sensor0 scm:sourced_from ?sourced0 . 
  ?sourced0 stardog:label \"ABB\" . 
  ?kegFiller0 a scm:KegFiller . 
  ?kegFiller0 scm:output ?productionOutput0 . 
  ?productionOutput0 a scm:Production_Output . 
  ?productionOutput0 scm:has_output ?product0 . 
  ?product0 a scm:Product . 
  ?product0 scm:packed_onto_skid ?skid0 . 
  ?skid0 a scm:Skid . 
  ?skid0 scm:delivered_to ?sellingPoint0 . 
}""" ;
   system:queryCreator "unknown" ;
   system:queryDatabase "kit-beer" ;
   system:voiceboxQuestion "Find all occurrences where a Consumer bought from a selling Point in which Product was deliverd to that was part of the production output of a keg filler monitored y a sensor whos data was sourced from the ABB datasource." .
