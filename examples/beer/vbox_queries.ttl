system:QueryQ10362 a system:StoredQuery , system:SharedQuery ;
   system:queryName "Q10362" ;
   system:queryString """SELECT DISTINCT ?label1 ?ingredientNameCount ?ingredients ?ingredientCount 
WHERE {
  ?recipe scm:outputs_product ?brand . 
  ?brand stardog:label \"Munich Dunkel\" . 

  {

    {
      SELECT ?ingredients (COUNT(?ingredients) AS ?ingredientCount) 
      WHERE {
        ?ingredients scm:used_in ?recipe . 
      }
      GROUP BY ?ingredients
    }
  }
  UNION {

    {
      SELECT ?label1 (COUNT(?label1) AS ?ingredientNameCount) 
      WHERE {
        ?ingredients rdfs:label ?label1 . 
        ?ingredients scm:used_in ?recipe . 
      }
      GROUP BY ?label1
    }
  }
}""" ;
   system:queryCreator "unknown" ;
   system:queryDatabase "kit-beer" ;
   system:voiceboxQuestion "Give the number of ingredients and the number of ingredient names for Munich Dunkel" .
