  {
    ?sensorIri scm:entity_type \"Temperature Sensor\" . 
    ?sensorIri scm:hasOutput ?anomaly0 . 
    ?anomaly0 a scm:Anomaly . 
    ?anomaly0 scm:sensorOutputValue ?sensorOutputValue . 
    ?anomaly0 scm:sensorReadingTimestamp ?sensorReadingTimestamp . 
    ?truckIri rdfs:label ?label0 . 
    ?truckIri scm:hasAnomaly ?anomaly0 . 
  BIND(SUBSTR(Str(?sensorReadingTimestamp), \"1\"^^xsd:integer, \"10\"^^xsd:integer) AS ?convertedDate)
  }
  ?label0 stardog:property:textMatch \"Truck 002\" . 
  FILTER (?convertedDate = \"2020-07-28\")
}
GROUP BY ?convertedDate""" ;
   system:queryCreator "unknown" ;
   system:queryDatabase "kit-beer" ;
   system:voiceboxQuestion "what was the average of the temperature anomalies detected by truck 2 on July 28, 2020?" , "find the average temperature of truck 2 anomalies from July 28, 2020." , "average of temperature anomalies for truck 2 on July 28, 2020." .
