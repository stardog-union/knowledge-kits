  so:domainIncludes scm:Product ;
  so:rangeIncludes scm:Skid .
scm:packed_onto_truck a owl:ObjectProperty ;
  rdfs:label "packed onto truck" ;
  so:domainIncludes scm:Skid ;
  so:rangeIncludes scm:Truck .
scm:part_of a owl:ObjectProperty ;
  rdfs:label "part of".
scm:part_of_distribution a owl:ObjectProperty ;
  rdfs:label "part of distribution" ;
  so:domainIncludes scm:Skid ;
  so:rangeIncludes scm:Distribution .
scm:recipe_used_in a owl:ObjectProperty ;
  rdfs:label "recipe used in" ;
  so:domainIncludes scm:Recipe ;
  so:rangeIncludes scm:Production_Output .
scm:providesFeedback a owl:ObjectProperty ;
  rdfs:label "provides feedback" ;
  so:domainIncludes scm:Consumer ;
  so:rangeIncludes scm:Product_Feedback . 
scm:buysFrom a owl:ObjectProperty ;
  rdfs:label "buys from" ;
  so:domainIncludes scm:Consumer ;
  so:rangeIncludes scm:Selling_Point . 
scm:purchases a owl:ObjectProperty ;
  rdfs:label "purchases" ;
  so:domainIncludes scm:Consumer ;
  so:rangeIncludes scm:Product .  
scm:supplies a owl:ObjectProperty ;
  rdfs:label "supplies" ;
  so:domainIncludes scm:Supplier ;
  so:rangeIncludes scm:Customer .  
scm:inProductsBoughtBy a owl:ObjectProperty ;
  rdfs:label "in products bought by" ;
  so:domainIncludes scm:Ingredient ;
  so:rangeIncludes scm:Customer .     
scm:selling_point_provides_feedback a owl:ObjectProperty ;
  rdfs:label "selling point provides feedback" ;
  so:domainIncludes scm:Selling_Point ;
  so:rangeIncludes scm:Product_Feedback .
scm:delivered_to a owl:ObjectProperty ;
  rdfs:label "delivered to" ;
  so:domainIncludes scm:Skid ;
  so:rangeIncludes scm:Selling_Point .
scm:stored_in a owl:ObjectProperty ;
  rdfs:label "stored in" ;
  so:domainIncludes scm:Skid ;
  so:rangeIncludes scm:Warehouse .
  

scm:anomaly_reason a owl:DatatypeProperty ;
  rdfs:label "anomaly reason" ;
  so:domainIncludes scm:SensorOutput ;
  so:rangeIncludes xsd:string .
scm:SkidDeliveryDateTime a owl:DatatypeProperty ;
  rdfs:label "skid delivery timestamp" ;
  so:domainIncludes scm:Skid ;
  so:rangeIncludes xsd:dateTime .
scm:stored_in_1 a owl:ObjectProperty ;
  rdfs:label "stored in" ;
  so:domainIncludes scm:Product ;
  so:rangeIncludes scm:Warehouse .
scm:used_in a owl:ObjectProperty ;
  rdfs:label "used in" ;
  so:domainIncludes scm:Ingredient ;
  so:rangeIncludes scm:Recipe .
scm:sourced_from a owl:ObjectProperty ;
  rdfs:label "sourced from" .
scm:feedback_for a owl:ObjectProperty ;
  rdfs:label "feedback for"	;
  so:domainIncludes scm:Product_Feedback ;
  so:rangeIncludes scm:Product .
scm:monitors a owl:ObjectProperty ;
            so:domainIncludes scm:Sensor ;
            so:rangeIncludes scm:Warehouse, scm:Equipment, scm:Truck,scm:Plant;
            rdfs:comment "link the sensor to the equipment being monitored" ;
            rdfs:label "monitors" .
scm:feeds a owl:ObjectProperty ;
            rdfs:label "feeds";
            so:domainIncludes scm:Equipment;
            so:rangeIncludes scm:Equipment;
            rdfs:label "feeds" .			
scm:output a owl:ObjectProperty ;
            rdfs:label "output";
            so:domainIncludes scm:Equipment;
            so:rangeIncludes scm:Production_Output.
			
scm:hasOutput a owl:ObjectProperty ;
            rdfs:label "has output";
            so:domainIncludes scm:Sensor;
            so:rangeIncludes scm:SensorOutput,scm:Anomaly.
scm:located_at a owl:ObjectProperty ;
            rdfs:label "located at";
            so:domainIncludes scm:Selling_Point;
            so:rangeIncludes scm:Customer.
scm:supplierOf rdf:type owl:ObjectProperty ;
              so:domainIncludes scm:Supplier ;
              so:rangeIncludes scm:Ingredient ;
              rdfs:comment "link a supplier to the ingredient they supply" ;
              rdfs:label "supplier of" .
scm:hasAddress rdf:type owl:ObjectProperty ;
              so:domainIncludes scm:Customer ;
              so:rangeIncludes scm:Address ;
              rdfs:label "has address" .
scm:hasAnomaly rdf:type owl:ObjectProperty ;
              so:domainIncludes scm:Truck ;
              so:rangeIncludes scm:Anomaly ;
              rdfs:label "has anomaly" .
scm:deliveredBy rdf:type owl:ObjectProperty ;
              so:domainIncludes scm:Product ;
              so:rangeIncludes scm:Truck ;
              rdfs:label "delivered by" .

