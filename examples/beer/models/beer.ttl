PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX so: <https://schema.org/>
PREFIX scm: <urn:demo:supplychain:model:> 
PREFIX stardog: <tag:stardog:api:>

scm:Consumer rdf:type owl:Class ;
                rdfs:label "Consumer" .
scm:Company rdf:type owl:Class ;
                rdfs:label "Company" .
scm:SensorOutput rdf:type owl:Class ;
                rdfs:label "Sensor Output" .
scm:Customer a owl:Class ;
  rdfs:label "Customer" .
scm:Distribution a owl:Class ;
  rdfs:label "Distribution" .
scm:Ingredient a owl:Class ;
  rdfs:label "Ingredient" .
scm:Ingredient_Type a owl:Class ;
  rdfs:label "Ingredient Type" .
scm:Pallet a owl:Class ;
  rdfs:label "Pallet" .
scm:Product a owl:Class ;
  rdfs:label "Finished Product" .
scm:Product_Brand a owl:Class ;
  rdfs:label "Product Brand" .
scm:Product_Feedback a owl:Class ;
  rdfs:label "Product Feedback" .
scm:Product_Type a owl:Class ;
  rdfs:label "Product Type" .
scm:Production_Output a owl:Class ;
  rdfs:label "Production Output" .
scm:Quality_Document a owl:Class ;
  rdfs:label "Quality Document" .
scm:Quality_Release a owl:Class ;
  rdfs:label "Quality Release" .
scm:Raw_Material_Ingredient a owl:Class ;
  rdfs:label "Raw Material Ingredient" .
scm:Raw_Material_Lot a owl:Class ;
  rdfs:label "Raw Material Lot" .
scm:Recipe a owl:Class ;
  rdfs:label "Recipe" .
scm:Selling_Point a owl:Class ;
  rdfs:label "Selling Point" .
scm:Skid a owl:Class ;
  rdfs:label "Skid" .
scm:Unit_of_Measure a owl:Class ;
  rdfs:label "Unit of Measure" .
scm:Warehouse a owl:Class ;
  rdfs:label "Warehouse" .
scm:Data_Source a owl:Class ;
  rdfs:label "Data Source" .
scm:Sensor a owl:Class ;
  rdfs:label "Sensor" .
scm:Equipment a owl:Class ;
  rdfs:label "Equipment" .
scm:Organization a owl:Class ;
  rdfs:label "Organization" .
scm:Vehicle a owl:Class ;
  rdfs:label "Vehicle" .
scm:Location a owl:Class ;
  rdfs:label "Location" .
scm:Fermenter a owl:Class ;
                rdfs:subClassOf scm:Equipment ;
                rdfs:label "Fermenter" .
scm:Whirlpool a owl:Class ;
                rdfs:subClassOf scm:Equipment ;
                rdfs:label "Whirlpool" .
scm:MaturingVat a owl:Class ;
                rdfs:subClassOf scm:Equipment ;
                rdfs:label "MaturingVat" .		
scm:KegFiller a owl:Class ;
                rdfs:subClassOf scm:Equipment ;
                rdfs:label "KegFiller" .
scm:Silo a owl:Class ;
                rdfs:subClassOf scm:Equipment ;
                rdfs:label "Silo" .
scm:FiltrationSystem a owl:Class ;
                rdfs:subClassOf scm:Equipment ;
                rdfs:label "FiltrationSystem" .				
scm:WaterTank a owl:Class ;
                rdfs:subClassOf scm:Equipment ;
                rdfs:label "WaterTank" .
scm:Cooler a owl:Class ;
                rdfs:subClassOf scm:Equipment ;
                rdfs:label "Cooler" .
scm:Boiler a owl:Class ;
                rdfs:subClassOf scm:Equipment ;
                rdfs:label "Boiler" .		
scm:Masher a owl:Class ;
                rdfs:subClassOf scm:Equipment ;
                rdfs:label "Masher" .
scm:Mill a owl:Class ;
                rdfs:subClassOf scm:Equipment ;
                rdfs:label "Mill" .
scm:ProductionLine a owl:Class ;
                rdfs:subClassOf scm:Equipment ;
                rdfs:label "Production Line" .
scm:Plant a owl:Class ;
         rdfs:subClassOf scm:Location ;
         rdfs:label "Manufacturing Plant" .
scm:Truck a owl:Class ;
         rdfs:subClassOf scm:Vehicle ;
         rdfs:label "Truck" .
scm:Distributor a owl:Class ;
               rdfs:subClassOf scm:Organization ;
               rdfs:label "Distributor" .
scm:Supplier a owl:Class ;
            rdfs:subClassOf scm:Organization ;
            rdfs:label "Supplier".
scm:Address a owl:Class;
            rdfs:label "Address".
scm:Anomaly a owl:Class;
rdfs:comment "Anomalies can impact the quality of the finished beer product" ;
rdfs:subClassOf scm:SensorOutput ;
            rdfs:label "Anomaly".
 
scm:delivery_means a owl:ObjectProperty ;
  rdfs:label "delivery means" ;
  so:domainIncludes scm:Truck ;
  so:rangeIncludes scm:Distribution .
scm:affects_quality_of a owl:ObjectProperty ;
  rdfs:label "affects quality of" ;
  so:domainIncludes scm:Anomaly;
  so:rangeIncludes scm:Product .
