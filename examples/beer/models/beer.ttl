  rdfs:label "ingredient used in" ;
  so:domainIncludes scm:Raw_Material_Ingredient ;
  so:rangeIncludes scm:Production_Output .
scm:is_type_of_ingredient a owl:ObjectProperty ;
  rdfs:label "is type of ingredient" ;
  so:domainIncludes scm:Ingredient ;
  so:rangeIncludes scm:Ingredient_Type .
scm:is_type_of_product a owl:ObjectProperty ;
  rdfs:label "is type of product" ;
  so:domainIncludes scm:Product ;
  so:rangeIncludes scm:Product_Type .
scm:line_has_output a owl:ObjectProperty ;
  rdfs:label "line has output" ;
  so:domainIncludes scm:ProductionLine ;
  so:rangeIncludes scm:Production_Output .
scm:lot_used_in a owl:ObjectProperty ;
  rdfs:label "lot used in" ;
