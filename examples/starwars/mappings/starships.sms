prefix stardog: <tag:stardog:api:>
prefix catalog: <tag:stardog:api:catalog:>
prefix m: <urn:stardog:modules:>
prefix kg: <tag:stardog:api:context:>
prefix sqs: <tag:stardog:api:sqs:>
prefix rule: <tag:stardog:api:rule:>
prefix sd: <urn:stardog:>
prefix sql: <tag:stardog:api:sql:>
prefix mp: <urn:stardog:marketplace:>

prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
prefix xsd: <http://www.w3.org/2001/XMLSchema#>
prefix owl: <http://www.w3.org/2002/07/owl#>
prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
prefix sh: <http://www.w3.org/ns/shacl#>

prefix skos: <http://www.w3.org/2004/02/skos/core#>
prefix foaf: <http://xmlns.com/foaf/0.1/>
prefix dcat: <http://www.w3.org/ns/dcat#>
prefix dct: <http://purl.org/dc/terms/>
prefix qudt: <http://qudt.org/schema/qudt/>
prefix unit: <http://qudt.org/vocab/unit/>
prefix void: <http://rdfs.org/ns/void#>
prefix so: <https://schema.org/>
prefix prov: <http://www.w3.org/ns/prov#>

prefix : <urn:example:starwars:>

MAPPING :StarshipsMapping
FROM CSV {
# name,model,manufacturer,cost_in_credits,length,max_atmosphering_speed,crew,passengers,cargo_capacity,consumables,hyperdrive_rating,MGLT,starship_class
}
TO {
	?iri a :Spacecraft ;
	    :starship_class ?starship_class ;
	    :length ?length ;
	    :manufacturer ?manufacturer ;
	    :model ?model ;
	    :consumables ?consumables ;
	    :capacity ?cargo_capacity ;
	    :crew ?crew ;
	    :cost ?cost_in_credits ;
	    :passengers ?passengers ;
	    :hyperdriveRating ?hyperdrive_rating ;
		:craftName ?name ;
		rdfs:label ?name .
}
WHERE {
	BIND(TEMPLATE("urn:example:starwars:craft:{name}") AS ?iri)
}