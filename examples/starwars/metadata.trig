prefix stardog: <tag:stardog:api:>
prefix catalog: <tag:stardog:api:catalog:>
prefix m: <urn:stardog:modules:>
prefix kg: <tag:stardog:api:context:>
prefix sqs: <tag:stardog:api:sqs:>
prefix rule: <tag:stardog:api:rule:>
prefix sd: <urn:stardog:>
prefix sql: <tag:stardog:api:sql:>

prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
prefix xsd: <http://www.w3.org/2001/XMLSchema#>
prefix owl: <http://www.w3.org/2002/07/owl#>
prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
prefix sh: <http://www.w3.org/ns/shacl#>

prefix foaf: <http://xmlns.com/foaf/0.1/>
prefix dcat: <http://www.w3.org/ns/dcat#>
prefix dct: <http://purl.org/dc/terms/>
prefix qudt: <http://qudt.org/schema/qudt/>
prefix unit: <http://qudt.org/vocab/unit/>
prefix void: <http://rdfs.org/ns/void#>
prefix so: <https://schema.org/>
prefix prov: <http://www.w3.org/ns/prov#>

prefix model: <urn:example:starwars:>
prefix : <urn:stardog:marketplace:stardog:starwars:>

model:model {
    model:model a m:DataModel ;
        void:triples 150 ;
        foaf:primaryTopic :Character ;
        rdfs:label "Star Wars Data Model".
}

model:data {
  model:data a dcat:Dataset ;
    rdfs:label "Star Wars Data" ;
    dct:description "A small dataset about the Star Wars Universe" ;
    void:triples 45000 ;
    foaf:primaryTopic :Character ;
    dcat:theme :Character .
}