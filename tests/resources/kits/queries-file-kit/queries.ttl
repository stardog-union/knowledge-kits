@prefix system: <http://system.stardog.com/> .

system:AutoGeneratedQuery201 a system:StoredQuery , system:SharedQuery ;
   system:queryName "file_query_1" ;
   system:queryString """SELECT DISTINCT ?person1 
WHERE {
  ?person0 a snvoc:Person . 
  ?person1 a snvoc:Person . 
  ?forum0 snvoc:hasModerator ?person1 . 
  ?forum0 snvoc:hasModerator ?person0 . 
  ?forum0 a snvoc:Forum . 
}
""" ;
   system:queryCreator "admin" ;
   system:queryDatabase "ldbcsf1" ;
   system:voiceboxQuestion "What are the people that are moderators of the forums that are moderated by Person 0?" , "What are the people that are moderators of the forums that are moderated by Person 2?" , "What are the people that are moderators of the forums that are moderated by Person 1?" .

system:AutoGeneratedQuery202 a system:StoredQuery , system:SharedQuery ;
   system:queryName "file_query_2" ;
   system:queryString """SELECT DISTINCT ?person1 
WHERE {
  ?post0 snvoc:hasCreator ?person0 . 
  ?post0 snvoc:browserUsed \"Chrome\" . 
  ?person0 a snvoc:Person . 
  ?person1 a snvoc:Person . 
  ?post0 a snvoc:Post . 
  ?post0 snvoc:hasCreator ?person1 . 
}
""" ;
   system:queryCreator "admin" ;
   system:queryDatabase "ldbcsf1" ;
   system:voiceboxQuestion "Who created a post that was viewed using Chrome?" .